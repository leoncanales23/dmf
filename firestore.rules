rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /enrollments/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
